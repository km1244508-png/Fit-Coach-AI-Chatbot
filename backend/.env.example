# Copy this file to .env and fill in real values. NEVER commit .env.
# Comments live on their own lines (inline comments break empty values).

# ---- App ----
# development | production
ENVIRONMENT=development
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
# Session lifetime in minutes (cookie + JWT expiry)
ACCESS_TOKEN_EXPIRE_MINUTES=720
COOKIE_NAME=access_token
# lax | strict | none   (none requires HTTPS)
COOKIE_SAMESITE=lax
# Leave empty for auto: Secure cookie is enabled in production
COOKIE_SECURE=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=health_coach

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
# Only needed for Qdrant Cloud / secured servers
QDRANT_API_KEY=
QDRANT_COLLECTION=health_fitness_kb

# ---- LLM + Embeddings (any OpenAI-compatible provider) ----
OPENAI_API_KEY=replace-with-your-provider-api-key
# Leave empty for the official OpenAI endpoint
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Must match the output size of EMBEDDING_MODEL (text-embedding-3-small = 1536)
EMBEDDING_DIM=1536

# ---- RAG / chat tuning ----
RAG_TOP_K=4
# Minimum cosine similarity for a chunk to count as "relevant"
RAG_SCORE_THRESHOLD=0.30
MAX_MESSAGE_LENGTH=4000
HISTORY_CONTEXT_MESSAGES=12
